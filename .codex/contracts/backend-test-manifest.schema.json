{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backend-test-manifest.schema.json",
  "title": "Backend test manifest",
  "description": "승인된 T-ID를 실제 Gradle test source와 exact selector에 연결하는 임시 검증 계약",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[1-9][0-9]*$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task",
                "source",
                "selector"
              ],
              "properties": {
                "task": {
                  "type": "string",
                  "enum": [
                    "test",
                    "postgresTest"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  }
}
