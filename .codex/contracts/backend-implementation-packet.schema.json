{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backend-implementation-packet.schema.json",
  "title": "Backend implementation packet",
  "description": "범위, 필수 테스트와 사람의 승인이 확정된 백엔드 구현 작업을 backend-developer에 위임하기 위한 입력 계약",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workItem",
    "canonicalSources",
    "allowedPaths",
    "forbiddenPaths",
    "completionCriteria",
    "postgresRequired",
    "postgresRequirementReasons",
    "requiredTests",
    "testContractApproval",
    "confirmedDecisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "issue"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "featureId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canonicalSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "section"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "allowedPaths": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "forbiddenPaths": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "completionCriteria": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "postgresRequired": {
      "description": "계획한 변경 범위가 실제 PostgreSQL 검증을 요구하는지 나타낸다. needs-review는 false로 확정하지 않고 true로 안전하게 처리한다.",
      "type": "boolean"
    },
    "postgresRequirementReasons": {
      "description": "PostgreSQL 검증 필요 여부를 판단한 변경 유형과 근거. 실제 diff 분류 결과는 manifest 검증에서 다시 대조한다.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "requiredTests": {
      "description": "사람이 이슈 코멘트에서 승인한 최신 전체 자연어 테스트 계약. 각 sourceRef는 전체 T-ID를 담은 정본 코멘트이며 testContractApproval.commentUrl과 같아야 한다.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intent",
          "sourceRef"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[1-9][0-9]*$"
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sourceRef": {
            "$ref": "#/$defs/githubIssueCommentUrl"
          }
        }
      }
    },
    "testContractApproval": {
      "description": "최신 전체 테스트 계약을 사람이 확정한 작업 이슈 번호와 정본 GitHub issue comment URL. 제안, 모델 판단 또는 PR 리뷰 코멘트는 승인으로 인정하지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issueNumber",
        "commentUrl"
      ],
      "properties": {
        "issueNumber": {
          "type": "integer",
          "minimum": 1
        },
        "commentUrl": {
          "$ref": "#/$defs/githubIssueCommentUrl"
        }
      }
    },
    "confirmedDecisions": {
      "$ref": "#/$defs/nonEmptyStringArray"
    }
  },
  "$defs": {
    "githubIssueCommentUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+/issues/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
