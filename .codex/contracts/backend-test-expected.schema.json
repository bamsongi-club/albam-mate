{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backend-test-expected.schema.json",
  "title": "Backend approved test execution graph",
  "description": "고정 snapshot에서 한 번씩 실행할 고유 명령과 승인 T-ID가 참조할 실행 증거를 분리한 입력 계약",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baseCommit",
    "implementationDiffHash",
    "trackedDiffHash",
    "packetHash",
    "executions",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "baseCommit": {
      "$ref": "#/$defs/commitSha"
    },
    "implementationDiffHash": {
      "$ref": "#/$defs/sha256"
    },
    "trackedDiffHash": {
      "$ref": "#/$defs/sha256"
    },
    "packetHash": {
      "$ref": "#/$defs/sha256"
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/testEvidence"
      }
    }
  },
  "$defs": {
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionId": {
      "type": "string",
      "pattern": "^E[1-9][0-9]*$"
    },
    "testId": {
      "type": "string",
      "pattern": "^T[1-9][0-9]*$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "junitTasks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/executionId"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000
        },
        "junitTasks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:_-]+$"
          }
        }
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "executionIds",
        "testSources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/testId"
        },
        "executionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/executionId"
          }
        },
        "testSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^src/(?:test|postgresTest)/java/.+\\.java$"
          }
        }
      }
    }
  }
}
