{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backend-test-result.schema.json",
  "title": "Backend test result",
  "description": "고정된 구현 snapshot에서 독립 backend-tester가 실제 실행한 승인 테스트 결과 계약",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshot",
    "startedSnapshot",
    "finishedSnapshot",
    "audit",
    "testResults",
    "overallVerdict",
    "overallReason"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "startedSnapshot": {
      "$ref": "#/$defs/executionSnapshot"
    },
    "finishedSnapshot": {
      "$ref": "#/$defs/executionSnapshot"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "testResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/testResult"
      }
    },
    "overallVerdict": {
      "enum": [
        "pass",
        "fail",
        "unverified"
      ]
    },
    "overallReason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "$defs": {
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "unverified"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "implementationDiffHash",
        "packetHash"
      ],
      "properties": {
        "baseCommit": {
          "$ref": "#/$defs/commitSha"
        },
        "implementationDiffHash": {
          "$ref": "#/$defs/sha256"
        },
        "packetHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "implementationDiffHash",
        "packetHash",
        "trackedDiffHash"
      ],
      "properties": {
        "baseCommit": {
          "$ref": "#/$defs/commitSha"
        },
        "implementationDiffHash": {
          "$ref": "#/$defs/sha256"
        },
        "packetHash": {
          "$ref": "#/$defs/sha256"
        },
        "trackedDiffHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionSourceModified",
        "testSourceModified",
        "stagePerformed",
        "commitPerformed",
        "pushPerformed",
        "pullRequestCreated"
      ],
      "properties": {
        "productionSourceModified": {
          "type": "boolean"
        },
        "testSourceModified": {
          "type": "boolean"
        },
        "stagePerformed": {
          "type": "boolean"
        },
        "commitPerformed": {
          "type": "boolean"
        },
        "pushPerformed": {
          "type": "boolean"
        },
        "pullRequestCreated": {
          "type": "boolean"
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "command",
        "durationMs",
        "exitCode",
        "verdict",
        "evidenceHash",
        "notRunReason"
      ],
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "^T[1-9][0-9]*$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "evidenceHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "notRunReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
