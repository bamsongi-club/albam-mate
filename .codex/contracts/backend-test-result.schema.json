{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backend-test-result.schema.json",
  "title": "Backend test result",
  "description": "고정된 구현 snapshot에서 결정적 runner가 실제 실행한 승인 테스트 결과 계약",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshot",
    "startedSnapshot",
    "finishedSnapshot",
    "preflight",
    "executionResults",
    "testResults",
    "overallVerdict",
    "overallReason"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "startedSnapshot": {
      "$ref": "#/$defs/executionSnapshot"
    },
    "finishedSnapshot": {
      "$ref": "#/$defs/executionSnapshot"
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "executionResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/executionResult"
      }
    },
    "testResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/testResult"
      }
    },
    "overallVerdict": {
      "enum": [
        "pass",
        "fail",
        "unverified"
      ]
    },
    "overallReason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "$defs": {
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "unverified"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "implementationDiffHash",
        "packetHash"
      ],
      "properties": {
        "baseCommit": {
          "$ref": "#/$defs/commitSha"
        },
        "implementationDiffHash": {
          "$ref": "#/$defs/sha256"
        },
        "packetHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "implementationDiffHash",
        "packetHash",
        "trackedDiffHash"
      ],
      "properties": {
        "baseCommit": {
          "$ref": "#/$defs/commitSha"
        },
        "implementationDiffHash": {
          "$ref": "#/$defs/sha256"
        },
        "packetHash": {
          "$ref": "#/$defs/sha256"
        },
        "trackedDiffHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "checks"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "unverified"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "verdict",
              "detail"
            ],
            "properties": {
              "name": {
                "enum": [
                  "result-directory",
                  "log-directory",
                  "jna-directory",
                  "gradle-wrapper",
                  "docker"
                ]
              },
              "verdict": {
                "enum": [
                  "pass",
                  "unverified"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "executionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId",
        "command",
        "commandHash",
        "durationMs",
        "exitCode",
        "verdict",
        "evidenceHash",
        "junitEvidence",
        "notRunReason"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "pattern": "^E[1-9][0-9]*$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "commandHash": {
          "$ref": "#/$defs/sha256"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "evidenceHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "junitEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/junitEvidence"
          }
        },
        "notRunReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "junitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "reportCount",
        "testCount",
        "reportHash"
      ],
      "properties": {
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:_-]+$"
        },
        "reportCount": {
          "type": "integer",
          "minimum": 1
        },
        "testCount": {
          "type": "integer",
          "minimum": 1
        },
        "reportHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "executionIds",
        "verdict",
        "notRunReason"
      ],
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "^T[1-9][0-9]*$"
        },
        "executionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^E[1-9][0-9]*$"
          }
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "notRunReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
