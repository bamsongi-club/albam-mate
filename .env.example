# Local PostgreSQL values only. Do not replace these with production credentials.
ALBAM_MATE_LOCAL_DB_HOST=localhost
ALBAM_MATE_LOCAL_DB_PORT=5432
ALBAM_MATE_LOCAL_DB_NAME=albam_mate_local
ALBAM_MATE_LOCAL_DB_USER=albam_mate
ALBAM_MATE_LOCAL_DB_PASSWORD=local-dev-password
ALBAM_MATE_LOCAL_REDIS_PORT=6380
ALBAM_MATE_LOCAL_PROXY_PORT=5173
ALBAM_MATE_CHAT_WEBSOCKET_ALLOWED_ORIGIN=http://localhost:5173

# Cloudflare Workers AI BGE-M3. Leave disabled unless an approved Top 1,000 release is present.
ALBAM_MATE_SEARCH_CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ALBAM_MATE_SEARCH_RELEASE_ID=
ALBAM_MATE_SEARCH_FIELD_VERSION=
ALBAM_MATE_SEARCH_MANIFEST_SHA256=
ALBAM_MATE_SEARCH_TEXT_CHECKSUM=

# Optional social login credentials. Leave a pair empty to hide that provider.
# Do not commit real values. Register the local callback URI in each developer console:
# http://localhost:5173/api/auth/social/callback/{google|naver|kakao}
ALBAM_MATE_GOOGLE_OAUTH_CLIENT_ID=
ALBAM_MATE_GOOGLE_OAUTH_CLIENT_SECRET=
ALBAM_MATE_NAVER_OAUTH_CLIENT_ID=
ALBAM_MATE_NAVER_OAUTH_CLIENT_SECRET=
ALBAM_MATE_KAKAO_OAUTH_CLIENT_ID=
ALBAM_MATE_KAKAO_OAUTH_CLIENT_SECRET=
