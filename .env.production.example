# 각 블록을 해당 노드의 파일로 복사한다. 한 파일 전체를 합쳐 배포하지 않는다.
# App1: /etc/albam-mate/app1.env + compose.production.yml
# App2: /etc/albam-mate/app2.env + compose.app2.yml
# PostgreSQL: /etc/albam-mate/postgres.env + compose.db.yml
# backend와 web 이미지는 같은 40자리 immutable Git SHA를 사용한다.

# App1 (/etc/albam-mate/app1.env)
ALBAM_MATE_IMAGE_NAMESPACE=registry.example.com/albam-mate
ALBAM_MATE_RELEASE=0123456789abcdef0123456789abcdef01234567
ALBAM_MATE_DB_HOST=postgres.albam-mate.internal
ALBAM_MATE_DB_PORT=5432
ALBAM_MATE_DB_NAME=albam_mate
ALBAM_MATE_DB_USER=albam_mate_app
ALBAM_MATE_DB_PASSWORD=replace-with-a-long-random-password
ALBAM_MATE_DB_MAXIMUM_POOL_SIZE=8
ALBAM_MATE_DB_MINIMUM_IDLE=2
ALBAM_MATE_REDIS_HOST=redis.albam-mate.internal
ALBAM_MATE_REDIS_PORT=6379
# 기본 provider는 fake이며, external provider는 #822 secret/egress 확인 뒤에 모든 gate를 명시해 연다.
ALBAM_MATE_ASSISTANT_ENABLED=true
ALBAM_MATE_ASSISTANT_PROVIDER=fake
ALBAM_MATE_ASSISTANT_PROVIDER_CONFIGURED=true
ALBAM_MATE_ASSISTANT_NO_RETENTION_VERIFIED=false
ALBAM_MATE_ASSISTANT_NO_TRAINING_VERIFIED=false
ALBAM_MATE_ASSISTANT_RETENTION_MODE=unverified
ALBAM_MATE_ASSISTANT_POLICY_VERSION=
ALBAM_MATE_ASSISTANT_POLICY_URL=
ALBAM_MATE_ASSISTANT_PRICING_SNAPSHOT=
ALBAM_MATE_ASSISTANT_INPUT_TOKEN_PRICE_USD_PER_MILLION=0
ALBAM_MATE_ASSISTANT_OUTPUT_TOKEN_PRICE_USD_PER_MILLION=0
ALBAM_MATE_ASSISTANT_MAX_INPUT_TOKENS=4096
ALBAM_MATE_ASSISTANT_MAX_OUTPUT_TOKENS=256
# 실제 API key는 이 예시가 아니라 #822의 secret 주입 경로에서만 전달한다.
ALBAM_MATE_ASSISTANT_OPENAI_API_KEY=
ALBAM_MATE_SEARCH_CLOUDFLARE_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ALBAM_MATE_SEARCH_RELEASE_ID=
ALBAM_MATE_SEARCH_FIELD_VERSION=
ALBAM_MATE_SEARCH_MANIFEST_SHA256=
ALBAM_MATE_SEARCH_TEXT_CHECKSUM=
JDK_JAVA_OPTIONS=-Xmx256m
ALBAM_MATE_OTLP_METRICS_URL=http://host.docker.internal:4318/v1/metrics
ALBAM_MATE_ENVIRONMENT=production
ALBAM_MATE_STACK_ID=albam-mate-production
ALBAM_MATE_ROLE=app1
ALBAM_MATE_INSTANCE_ID=app1
ALBAM_MATE_OBSERVABILITY_LOG_PATH=/var/log/albam-mate
ALBAM_MATE_APP2_HOST=app-b.albam-mate.internal
ALBAM_MATE_HTTPS_BIND_ADDRESS=127.0.0.1
ALBAM_MATE_TLS_PATH=/etc/albam-mate/tls
ALBAM_MATE_WEB_MEMORY_LIMIT=128m

# 선택 소셜 로그인은 ID와 secret을 함께 비워 두면 해당 제공자만 비활성화된다.
ALBAM_MATE_GOOGLE_OAUTH_CLIENT_ID=
ALBAM_MATE_GOOGLE_OAUTH_CLIENT_SECRET=
ALBAM_MATE_NAVER_OAUTH_CLIENT_ID=
ALBAM_MATE_NAVER_OAUTH_CLIENT_SECRET=
ALBAM_MATE_KAKAO_OAUTH_CLIENT_ID=
ALBAM_MATE_KAKAO_OAUTH_CLIENT_SECRET=
# 비워 두면 모든 WebSocket handshake를 거절한다.
ALBAM_MATE_CHAT_WEBSOCKET_ALLOWED_ORIGIN=
ALBAM_MATE_LOG_MAX_SIZE=10m
ALBAM_MATE_LOG_MAX_FILES=5

# App2 (/etc/albam-mate/app2.env)
ALBAM_MATE_IMAGE_NAMESPACE=registry.example.com/albam-mate
ALBAM_MATE_RELEASE=0123456789abcdef0123456789abcdef01234567
ALBAM_MATE_DB_HOST=postgres.albam-mate.internal
ALBAM_MATE_DB_PORT=5432
ALBAM_MATE_DB_NAME=albam_mate
ALBAM_MATE_DB_USER=albam_mate_app
ALBAM_MATE_DB_PASSWORD=replace-with-a-long-random-password
ALBAM_MATE_DB_MAXIMUM_POOL_SIZE=8
ALBAM_MATE_DB_MINIMUM_IDLE=2
ALBAM_MATE_REDIS_HOST=redis.albam-mate.internal
ALBAM_MATE_REDIS_PORT=6379
# App1과 동일한 AI gate를 전달한다. 실제 API key는 #822의 secret 주입 경로에서만 전달한다.
ALBAM_MATE_ASSISTANT_ENABLED=true
ALBAM_MATE_ASSISTANT_PROVIDER=fake
ALBAM_MATE_ASSISTANT_PROVIDER_CONFIGURED=true
ALBAM_MATE_ASSISTANT_NO_RETENTION_VERIFIED=false
ALBAM_MATE_ASSISTANT_NO_TRAINING_VERIFIED=false
ALBAM_MATE_ASSISTANT_RETENTION_MODE=unverified
ALBAM_MATE_ASSISTANT_POLICY_VERSION=
ALBAM_MATE_ASSISTANT_POLICY_URL=
ALBAM_MATE_ASSISTANT_PRICING_SNAPSHOT=
ALBAM_MATE_ASSISTANT_INPUT_TOKEN_PRICE_USD_PER_MILLION=0
ALBAM_MATE_ASSISTANT_OUTPUT_TOKEN_PRICE_USD_PER_MILLION=0
ALBAM_MATE_ASSISTANT_MAX_INPUT_TOKENS=4096
ALBAM_MATE_ASSISTANT_MAX_OUTPUT_TOKENS=256
ALBAM_MATE_ASSISTANT_OPENAI_API_KEY=
ALBAM_MATE_SEARCH_CLOUDFLARE_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ALBAM_MATE_SEARCH_RELEASE_ID=
ALBAM_MATE_SEARCH_FIELD_VERSION=
ALBAM_MATE_SEARCH_MANIFEST_SHA256=
ALBAM_MATE_SEARCH_TEXT_CHECKSUM=
JDK_JAVA_OPTIONS=-Xmx256m
ALBAM_MATE_OTLP_METRICS_URL=http://host.docker.internal:4318/v1/metrics
ALBAM_MATE_ENVIRONMENT=production
ALBAM_MATE_STACK_ID=albam-mate-production
ALBAM_MATE_ROLE=app2
ALBAM_MATE_INSTANCE_ID=app2
ALBAM_MATE_OBSERVABILITY_LOG_PATH=/var/log/albam-mate

# 선택 소셜 로그인과 WebSocket Origin은 두 Spring 노드에 동일하게 전달한다.
ALBAM_MATE_GOOGLE_OAUTH_CLIENT_ID=
ALBAM_MATE_GOOGLE_OAUTH_CLIENT_SECRET=
ALBAM_MATE_NAVER_OAUTH_CLIENT_ID=
ALBAM_MATE_NAVER_OAUTH_CLIENT_SECRET=
ALBAM_MATE_KAKAO_OAUTH_CLIENT_ID=
ALBAM_MATE_KAKAO_OAUTH_CLIENT_SECRET=
ALBAM_MATE_CHAT_WEBSOCKET_ALLOWED_ORIGIN=
ALBAM_MATE_LOG_MAX_SIZE=10m
ALBAM_MATE_LOG_MAX_FILES=5

# PostgreSQL (/etc/albam-mate/postgres.env)
ALBAM_MATE_DB_NAME=albam_mate
ALBAM_MATE_DB_USER=albam_mate_app
ALBAM_MATE_DB_PASSWORD=replace-with-a-long-random-password

# Redis (전용 환경 파일 없음)
# 현재 Compose 기준으로 Redis 전용 환경변수와 비밀값은 없다.
