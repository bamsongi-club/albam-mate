# Copy this file outside the repository to /etc/albam-mate/production.env,
# restrict it to the deployment account, and replace every example value.

# CI publishes namespace/backend and namespace/web with this one immutable Git SHA.
ALBAM_MATE_IMAGE_NAMESPACE=registry.example.com/albam-mate
ALBAM_MATE_RELEASE=0123456789abcdef0123456789abcdef01234567

ALBAM_MATE_HTTPS_BIND_ADDRESS=0.0.0.0
ALBAM_MATE_TLS_PATH=/etc/albam-mate/tls
ALBAM_MATE_RDS_CA_PATH=/etc/albam-mate/rds-ca-bundle.pem

ALBAM_MATE_DB_HOST=replace-with-rds-endpoint.ap-northeast-2.rds.amazonaws.com
ALBAM_MATE_DB_PORT=5432
ALBAM_MATE_DB_NAME=albam_mate
ALBAM_MATE_DB_USER=albam_mate_app
ALBAM_MATE_DB_PASSWORD=replace-with-a-long-random-password
ALBAM_MATE_DB_MAXIMUM_POOL_SIZE=8
ALBAM_MATE_DB_MINIMUM_IDLE=2

ALBAM_MATE_REDIS_HOST=replace-with-redis-endpoint.internal
ALBAM_MATE_REDIS_PORT=6379

ALBAM_MATE_SPRING_MEMORY_LIMIT=1024m
ALBAM_MATE_WEB_MEMORY_LIMIT=128m
ALBAM_MATE_LOG_MAX_SIZE=10m
ALBAM_MATE_LOG_MAX_FILES=5
