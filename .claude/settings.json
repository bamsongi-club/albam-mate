{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.bamsongi/hooks/user-prompt.mjs",
              "--tool",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
